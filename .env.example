# Docker Compose
POSTGRES_USER=portafolio
POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme_use_a_long_random_string
JWT_REFRESH_SECRET=          # Opcional. Si no se setea, se deriva de JWT_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
PORT=80
CORS_ORIGIN=*

# Backend (local dev -- not needed for Docker)
DATABASE_URL=postgresql://portafolio:changeme@localhost:5432/portafolio

# Frontend (local dev -- not needed for Docker)
VITE_API_URL=                # Opcional. Si no se setea, usa el proxy de Vite (localhost:3001)
